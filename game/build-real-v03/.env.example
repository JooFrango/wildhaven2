# Wildhaven Build Real v01 — exemplo de configuração (SEM segredos).
# Copie para .env e ajuste. Caminhos relativos são resolvidos a partir de WH_REPO_ROOT.
# Carregar no shell:  set -a; . ./.env; set +a

# Raiz do repositório, relativa ao diretório game/build-real-v01/server (onde o servidor é iniciado)
WH_REPO_ROOT=../../..
WH_BIND=127.0.0.1:8787

# Saídas do pipeline continental (geradas localmente, não versionadas)
WH_PHYSICS_DIR=.generated/physics-272
WH_SOURCES_DIR=.generated/sources
WH_PORTAL_REPORT=build real/integracao/relatorio-continental-272.json

# Mundo
WH_WORLD_ID=auralis-v01
# Época do relógio global (ms Unix). Vazio = agora (ou a época já gravada no PostgreSQL).
WH_CLOCK_EPOCH_MS=
# Passos de simulação por intervalo de 200 ms (1 = tempo real; máx. 50) — só para revisão.
WH_TIME_SCALE=1
# 1 = libera pacotes NÃO certificados (modo revisão técnica). Padrão: desligado.
WH_ALLOW_UNCERTIFIED=0
WH_CACHE_MB=256

# PostgreSQL opcional. Vazio = estado só em memória.
# Formato: postgres://USUARIO:SENHA@127.0.0.1:5432/BANCO — defina a senha localmente, nunca a commite.
DATABASE_URL=
